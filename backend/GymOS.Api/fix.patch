diff --git a/Orderly.Api/Infrastructure/Services/BannerRules.cs b/Orderly.Api/Infrastructure/Services/BannerRules.cs
new file mode 100644
index 0000000..954f943
--- /dev/null
+++ b/Orderly.Api/Infrastructure/Services/BannerRules.cs
@@ -0,0 +1,104 @@
+using System.Text.RegularExpressions;
+using Microsoft.AspNetCore.Http;
+using Orderly.Api.Core.Dtos.Banners;
+
+namespace Orderly.Api.Infrastructure.Services;
+
+/// <summary>القيم المنظفة لحقول بانر الكارت.</summary>
+public sealed record BannerContent(
+    string? LayoutStyle,
+    string? Title,
+    string? Subtitle,
+    string? ButtonText,
+    string? CutoutAlign,
+    string? BgColor);
+
+/// <summary>قواعد التحقق من بانر الكارت (cutout) في مكان واحد وقابلة للاختبار.</summary>
+public static class BannerRules
+{
+    public const string CutoutStyle = "cutout";
+    public const int MaxTitle = 40;
+    public const int MaxSubtitle = 80;
+    public const int MaxButtonText = 20;
+    public const long MaxCutoutBytes = 2 * 1024 * 1024;
+
+    private static readonly Regex HexColor = new("^#?[0-9A-Fa-f]{6}$", RegexOptions.Compiled);
+
+    /// <summary>
+    /// بينظف ويتحقق من حقول البانر. بيرمي BadHttpRequestException لو فيه مشكلة.
+    /// </summary>
+    /// <param name="request">الطلب</param>
+    /// <param name="existingStyle">LayoutStyle الحالي للبانر عند التعديل (null عند الإنشاء)</param>
+    /// <param name="isCreate">إنشاء جديد؟</param>
+    public static BannerContent Normalize(BannerRequest request, string? existingStyle, bool isCreate)
+    {
+        var style = string.IsNullOrWhiteSpace(request.LayoutStyle)
+            ? null
+            : request.LayoutStyle.Trim().ToLowerInvariant();
+
+        if (style != null && style != CutoutStyle)
+            throw new BadHttpRequestException("نوع البنر غير مدعوم.");
+
+        if (style == null)
+        {
+            // بانر صورة كاملة قديم: مفيش نصوص
+            return new BannerContent(null, null, null, null, null, null);
+        }
+
+        var title = request.Title?.Trim();
+        if (string.IsNullOrEmpty(title))
+            throw new BadHttpRequestException("عنوان البنر مطلوب.");
+        if (title.Length > MaxTitle)
+            throw new BadHttpRequestException($"العنوان لا يزيد عن {MaxTitle} حرف.");
+
+        var subtitle = NullIfEmpty(request.Subtitle);
+        if (subtitle != null && subtitle.Length > MaxSubtitle)
+            throw new BadHttpRequestException($"الوصف لا يزيد عن {MaxSubtitle} حرف.");
+
+        var buttonText = NullIfEmpty(request.ButtonText);
+        if (buttonText != null && buttonText.Length > MaxButtonText)
+            throw new BadHttpRequestException($"نص الزر لا يزيد عن {MaxButtonText} حرف.");
+
+        var align = NullIfEmpty(request.CutoutAlign)?.ToLowerInvariant() ?? "end";
+        if (align != "start" && align != "end")
+            throw new BadHttpRequestException("اتجاه الصورة لازم يكون start أو end.");
+
+        string? color = null;
+        var rawColor = NullIfEmpty(request.BgColor);
+        if (rawColor != null)
+        {
+            if (!HexColor.IsMatch(rawColor))
+                throw new BadHttpRequestException("لون الخلفية لازم يكون بصيغة #RRGGBB.");
+            color = "#" + rawColor.TrimStart('#').ToUpperInvariant();
+        }
+
+        // الصورة المفرغة
+        var hasFile = request.ImageFile is { Length: > 0 };
+        if (isCreate && !hasFile)
+            throw new BadHttpRequestException("الصورة المفرغة مطلوبة.");
+        if (!isCreate && existingStyle != CutoutStyle && !hasFile)
+            throw new BadHttpRequestException("لازم ترفع صورة مفرغة عند التحويل لبنر كارت.");
+        if (hasFile)
+            ValidateCutoutFile(request.ImageFile!);
+
+        return new BannerContent(CutoutStyle, title, subtitle, buttonText, align, color);
+    }
+
+    public static void ValidateCutoutFile(IFormFile file)
+    {
+        var ext = Path.GetExtension(file.FileName ?? string.Empty).ToLowerInvariant();
+        var type = (file.ContentType ?? string.Empty).ToLowerInvariant();
+        var okExt = ext is ".png" or ".webp";
+        var okType = type is "image/png" or "image/webp";
+        if (!okExt || !okType)
+            throw new BadHttpRequestException("الصورة المفرغة لازم تكون PNG أو WebP.");
+        if (file.Length > MaxCutoutBytes)
+            throw new BadHttpRequestException("حجم الصورة المفرغة لازم يكون أقل من 2 ميجا.");
+    }
+
+    private static string? NullIfEmpty(string? v)
+    {
+        var t = v?.Trim();
+        return string.IsNullOrEmpty(t) ? null : t;
+    }
+}
