diff --git a/Orderly.Api/Scripts/2026-11-26_banners_cutout.sql b/Orderly.Api/Scripts/2026-11-26_banners_cutout.sql
new file mode 100644
index 0000000..b807465
--- /dev/null
+++ b/Orderly.Api/Scripts/2026-11-26_banners_cutout.sql
@@ -0,0 +1,19 @@
+-- بانر الكارت المبني بالكود (cutout): أعمدة جديدة كلها NULL، فالبانرات القديمة بتفضل شغالة زي ما هي.
+-- شغّله مرة واحدة على قاعدة البيانات (SQL Server). آمن لو اتشغل تاني.
+-- لازم يتشغل قبل نشر الباك إند الجديد.
+
+IF COL_LENGTH('dbo.Banners', 'LayoutStyle') IS NULL
+    ALTER TABLE dbo.Banners ADD LayoutStyle nvarchar(20) NULL;
+IF COL_LENGTH('dbo.Banners', 'Title') IS NULL
+    ALTER TABLE dbo.Banners ADD Title nvarchar(100) NULL;
+IF COL_LENGTH('dbo.Banners', 'Subtitle') IS NULL
+    ALTER TABLE dbo.Banners ADD Subtitle nvarchar(200) NULL;
+IF COL_LENGTH('dbo.Banners', 'ButtonText') IS NULL
+    ALTER TABLE dbo.Banners ADD ButtonText nvarchar(50) NULL;
+IF COL_LENGTH('dbo.Banners', 'CutoutAlign') IS NULL
+    ALTER TABLE dbo.Banners ADD CutoutAlign nvarchar(10) NULL;
+IF COL_LENGTH('dbo.Banners', 'BgColor') IS NULL
+    ALTER TABLE dbo.Banners ADD BgColor nvarchar(9) NULL;
+
+-- للتراجع (لو احتجت):
+-- ALTER TABLE dbo.Banners DROP COLUMN LayoutStyle, Title, Subtitle, ButtonText, CutoutAlign, BgColor;
