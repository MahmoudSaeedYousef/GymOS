+using FluentAssertions;
+using Microsoft.AspNetCore.Http;
+using Moq;
+using Orderly.Api.Core.Dtos.Banners;
+using Orderly.Api.Infrastructure.Services;
+using Xunit;
+
+namespace Orderly.Api.Tests.Banners;
+
+public class BannerRulesTests
+{
+    private static IFormFile File(string name = "jacket.png", string type = "image/png", long length = 1000)
+    {
+        var f = new Mock<IFormFile>();
+        f.Setup(x => x.FileName).Returns(name);
+        f.Setup(x => x.ContentType).Returns(type);
+        f.Setup(x => x.Length).Returns(length);
+        return f.Object;
+    }
+
+    private static BannerRequest Cutout(IFormFile? file = null) => new()
+    {
+        LayoutStyle = "cutout",
+        Title = "خصم 20%",
+        ImageFile = file ?? File(),
+    };
+
+    [Fact]
+    public void OldStyle_NoLayoutStyle_ClearsTextFields()
+    {
+        var request = new BannerRequest { ImageFile = File("a.jpg", "image/jpeg"), Title = "x" };
+
+        var c = BannerRules.Normalize(request, existingStyle: null, isCreate: true);
+
+        c.LayoutStyle.Should().BeNull();
+        c.Title.Should().BeNull();
+        c.CutoutAlign.Should().BeNull();
+    }
+
+    [Fact]
+    public void Cutout_Valid_DefaultsAlignToEndAndNormalizesColor()
+    {
+        var request = Cutout();
+        request.BgColor = "1e40af";
+        request.Subtitle = "  لفترة محدودة  ";
+
+        var c = BannerRules.Normalize(request, null, isCreate: true);
+
+        c.LayoutStyle.Should().Be("cutout");
+        c.CutoutAlign.Should().Be("end");
+        c.BgColor.Should().Be("#1E40AF");
+        c.Subtitle.Should().Be("لفترة محدودة");
+    }
+
+    [Fact]
+    public void Cutout_WithoutTitle_Throws()
+    {
+        var request = Cutout();
+        request.Title = "  ";
+
+        var act = () => BannerRules.Normalize(request, null, isCreate: true);
+
+        act.Should().Throw<BadHttpRequestException>();
+    }
+
+    [Theory]
+    [InlineData("a.jpg", "image/jpeg")]
+    [InlineData("a.png", "image/jpeg")]
+    [InlineData("a.gif", "image/gif")]
+    public void Cutout_WrongFileType_Throws(string name, string type)
+    {
+        var act = () => BannerRules.Normalize(Cutout(File(name, type)), null, isCreate: true);
+
+        act.Should().Throw<BadHttpRequestException>();
+    }
+
+    [Fact]
+    public void Cutout_FileTooLarge_Throws()
+    {
+        var act = () => BannerRules.Normalize(
+            Cutout(File(length: BannerRules.MaxCutoutBytes + 1)), null, isCreate: true);
+
+        act.Should().Throw<BadHttpRequestException>();
+    }
+
+    [Theory]
+    [InlineData("middle")]
+    [InlineData("left")]
+    public void Cutout_BadAlign_Throws(string align)
+    {
+        var request = Cutout();
+        request.CutoutAlign = align;
+
+        var act = () => BannerRules.Normalize(request, null, isCreate: true);
+
+        act.Should().Throw<BadHttpRequestException>();
+    }
+
+    [Fact]
+    public void Cutout_BadColor_Throws()
+    {
+        var request = Cutout();
+        request.BgColor = "red";
+
+        var act = () => BannerRules.Normalize(request, null, isCreate: true);
+
+        act.Should().Throw<BadHttpRequestException>();
+    }
+
+    [Fact]
+    public void Update_ExistingCutout_AllowsEditWithoutNewFile()
+    {
+        var request = Cutout();
+        request.ImageFile = null;
+
+        var c = BannerRules.Normalize(request, existingStyle: "cutout", isCreate: false);
+
+        c.Title.Should().Be("خصم 20%");
+    }
+
+    [Fact]
+    public void Update_OldBannerToCutout_RequiresNewFile()
+    {
+        var request = Cutout();
+        request.ImageFile = null;
+
+        var act = () => BannerRules.Normalize(request, existingStyle: null, isCreate: false);
+
+        act.Should().Throw<BadHttpRequestException>();
+    }
+}
